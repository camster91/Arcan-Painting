# Arcan Painting - Environment Variables
# Copy this to .env for local development
# For production, set these in Coolify/Railway/Vercel

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@neon-host.neon.tech/dbname?sslmode=require"

# Authentication
SESSION_SECRET="change-this-to-a-secure-random-string"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-secure-random-string"

# Application
NODE_ENV="development"
PORT=3000
HOST="0.0.0.0"

# Stripe (optional)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Email (optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@arcanpainting.com"

# Google Maps (optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# OpenClaw AI Assistant
OPENCLAW_URL="http://localhost:18789"
OPENCLAW_TOKEN=""
# Required for server-to-server calls to internal agent endpoints. Generate a
# long random value and set it only in the deployment environment.
INTERNAL_API_TOKEN="replace-with-a-long-random-secret"

# Feature flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_MAINTENANCE_MODE=false

# ── Sentry Error Tracking + Observability ────────────────────────────────────
# Get your DSN from: https://sentry.io → Settings → Projects → Client Keys
SENTRY_DSN="https://your-public-key@oXXXXXX.ingest.sentry.io/XXXXXXX"

# Public DSN (safe to expose client-side)
NEXT_PUBLIC_SENTRY_DSN="https://your-public-key@oXXXXXX.ingest.sentry.io/XXXXXXX"

# Auth token for source map uploads (CI/CD only, NEVER commit to git)
# Create at: https://sentry.io → Settings → Account → API → Auth Tokens
# Required scopes: project:releases, project:write
SENTRY_AUTH_TOKEN="sntrys_..."

# Organization + project slugs (from your Sentry URL)
SENTRY_ORG="your-org-slug"
SENTRY_PROJECT="arcan-painting"

# Release version — auto-set by build script from git commit hash
# Leave empty; CI/CD fills this in automatically
SENTRY_RELEASE=""
