{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "arcan-enquiry-intake",
  "main": "index.js",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "arcan-enquiries",
      "database_id": "a894afcd-504a-4d3a-a498-905296f0bdc8",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "ENQUIRY_LIMITER",
      "namespace_id": "18420261024",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "account_id": "1f5acce966c81fbe36ae06521414d0b8",
  "env": {
    "production": {
      "account_id": "1b2e351cbb39ab6b80efe36ca3577fe5",
      "name": "arcan-enquiry-intake",
      "vars": {
        "NOTIFY_FROM": "notifications@enquiries.arcanpainting.ca",
        "NOTIFY_TO": "info@arcanpainting.ca"
      },
      "send_email": [
        {
          "name": "EMAIL",
          "destination_address": "info@arcanpainting.ca",
          "allowed_sender_addresses": [
            "notifications@enquiries.arcanpainting.ca"
          ]
        }
      ],
      "d1_databases": [
        {
          "binding": "LEADS_DB",
          "database_name": "arcan-enquiries-production",
          "database_id": "d85b0cf8-2574-48b0-86f5-2ee5f8c891d0",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "ENQUIRY_LIMITER",
          "namespace_id": "18420261024",
          "simple": {
            "limit": 5,
            "period": 60
          }
        }
      ]
    }
  }
}
