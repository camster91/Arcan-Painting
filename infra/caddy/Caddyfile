{
    email admin@alinenasseh.com
    admin off
}

# alinenasseh.com (production) — proxy to the PHP app container
alinenasseh.com, www.alinenasseh.com {
    encode gzip zstd
    reverse_proxy 127.0.0.1:9090 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        transport http {
            dial_timeout 30s
            response_header_timeout 60s
        }
    }
    @assets {
        path *.css *.js *.svg *.png *.jpg *.jpeg *.webp *.woff2 *.ico
    }
    header @assets Cache-Control "public, max-age=31536000, immutable"
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    log {
        output file /data/alinenasseh.com.log {
            roll_size 50mb
            roll_keep 5
        }
    }
}

# Arcan Painting apex (added 2026-06-12) — apex domain also routes to
# the same Node app as the subdomain. Auto-issues LE cert via on-demand
# (the global on_demand_tls block at the top authorizes via the
# contraction-tracker SPA fallback).
arcanpainting.ca, www.arcanpainting.ca {
  reverse_proxy 127.0.0.1:3000 {
    # Overwrite, never append, client-provided forwarding headers before the
    # app's trusted-proxy rate limiting reads them.
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }
}

# artisan.ashbi.ca — preview URL for the new PHP app
artisan.ashbi.ca {
    encode gzip zstd
    reverse_proxy 127.0.0.1:9090 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        transport http {
            dial_timeout 30s
        }
    }
    log {
        output file /data/artisan.ashbi.ca.log {
            roll_size 50mb
            roll_keep 5
        }
    }
}

